# ── Hệ điều hành / IDE ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Script chạy tay trên máy Windows ─────────────────────────────────────────
# Chỉ phục vụ máy dev, không dùng khi triển khai bằng Docker.
*.bat
*.cmd
*.ps1
# Trừ deploy.bat: đó là vỏ bọc gọi deploy.sh từ cmd.exe, KHÔNG phải script dev.
# Máy Windows nào clone repo về cũng cần nó để triển khai mà không phải mở Git Bash.
!deploy.bat

# ── Thư mục không đẩy lên remote ──────────────────────────────────────────────
# Dấu "/" ở đầu neo vào thư mục gốc: không đụng tới `backend/app/scripts/`
# và `backend/app/data/` là mã nguồn thật.
/docs/
/scripts/
/backups/

# ── Bí mật ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.local.example
secrets/
*.key
*.pem

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Dữ liệu và file người dùng tải lên ───────────────────────────────────────
storage/
*.db
*.sqlite3
*.sql
*.log

# Trừ danh mục mã: dữ liệu tham chiếu công khai (mã, sàn, tên công ty, ngành),
# không có gì riêng tư. Máy mới clone về mà thiếu file này thì bảng `symbols`
# rỗng và toàn bộ màn hình thị trường trắng trơn. deploy.sh nạp nó ở bước 7.
# Tài khoản thật nằm ở backups/clone_accounts.sql và vẫn bị chặn — cố ý.
!backend/seed_data/*.sql
