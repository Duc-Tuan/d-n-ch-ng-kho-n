# ============================================================
#  BIẾN MÔI TRƯỜNG — sao chép file này thành `.env` rồi điền giá trị thật
#  KHÔNG commit file .env lên repo (BR-881)
# ============================================================

APP_NAME="He thong tu van chung khoan"
APP_ENV=development            # development | staging | production
DEBUG=true
API_PREFIX=/api/v1
TIMEZONE=Asia/Ho_Chi_Minh

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stock_system
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Bảo mật / JWT ----------
# BR-000: hai secret KHÁC NHAU cho hai site. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_CUSTOMER=doi-gia-tri-nay-truoc-khi-chay-that
JWT_SECRET_STAFF=doi-gia-tri-nay-truoc-khi-chay-that-va-khac-cai-tren
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000

# ---------- Chính sách tài khoản ----------
TRIAL_DAYS=7
GRACE_DAYS=3
EMAIL_VERIFY_TTL_HOURS=24
UNVERIFIED_PURGE_DAYS=7
LOGIN_MAX_ATTEMPTS=5                 # BR-110
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10                   # BR-120
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_PER_HOUR=3
SINGLE_SESSION=true                  # BR-111: 1 phiên hoạt động tại một thời điểm
DEVICE_ALERT_THRESHOLD=5             # >5 thiết bị/30 ngày => cờ đỏ dashboard
TRIAL_PER_IP_PER_DAY=3               # BR-105
REQUIRE_PHONE_OTP=false              # bật khi đã đấu nối nhà cung cấp SMS

# ---------- Compliance (Phần 2.6) ----------
COMPLIANCE_NAV_MIN=100000000         # C2 - ngưỡng NAV tối thiểu (VND)
COMPLIANCE_NAV_WINDOW=20             # số phiên tính trung bình (BR-300)
COMPLIANCE_NO_TRADE_DAYS=90          # C1
COMPLIANCE_WARNING_DAYS=7            # BR-302
IB_LINK_DEADLINE_DAYS=15             # BR-210 phương án B

# ---------- Google Sheet đồng bộ NAV (BR-401) ----------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=NAV!A2:G
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
NAV_SYNC_MAX_ROW_DROP_PCT=20         # BR-403.2
NAV_SYNC_RETRY=3                     # BR-405
NAV_SYNC_RETRY_DELAY_SECONDS=300

# ---------- Job scheduler (Phần 6) ----------
ENABLE_SCHEDULER=true
JOB_SYNC_NAV_CRON=15 15 * * *
JOB_CHECK_COMPLIANCE_CRON=30 16 * * *
JOB_CHECK_SUBSCRIPTION_CRON=5 0 * * *
JOB_NOTIFY_EXPIRY_CRON=0 9 * * *
JOB_NOTIFY_WARNING_CRON=0 9 * * *
JOB_CLOSE_SIGNALS_CRON=0 16 * * *
JOB_CLEANUP_CRON=0 2 * * *
# Cap nhat gia cuoi ngay: 16:00 thu 2-6 (ngay le tu bo qua theo trading_calendar)
# Dung mon-fri, KHONG dung 1-5: APScheduler danh so 0=thu 2 nen 1-5 la thu 3 den thu 7
JOB_SYNC_MARKET_CRON=0 16 * * mon-fri

# Gio keo tin dan nguon (HH:MM). Chi la gia tri du phong: gio dang co hieu luc nam o cau
# hinh `news_sync_time` sua duoc trong man Cau hinh he thong.
JOB_SYNC_NEWS_TIME=04:10

# ---------- Phan tich theo yeu cau (MCP + claude -p) ----------
# Khach hang bam nut Phan tich o man chien luoc. Khong con job quet san hang ngay.
#
# Claude Code CLI. Phai cai va DANG NHAP bang chinh nguoi dung he dieu hanh dang chay backend:
# ho so OAuth luu theo user. Khong can ANTHROPIC_API_KEY (khong dung co --bare).
AI_CLAUDE_CLI_PATH=claude
AI_MCP_CONFIG_PATH=.claude/mcp-analysis.json

# So nen nap cho mo hinh doc, va tran thoi gian cho mot luot phan tich mot ma.
AI_CANDLES_PER_SYMBOL=300
AI_ANALYSIS_TIMEOUT_SECONDS=600

# So luot CHAY AI MOI moi tai khoan duoc dung mot ngay.
# Doc lai ban da co (ai do da phan tich cap chien luoc+ma do trong ngay) KHONG tinh luot.
# Chien luoc loai RULE chay bo dieu kien tai cho cung khong tinh luot.
ANALYSIS_DAILY_QUOTA=10

# So tien trinh `claude -p` chay song song. Moi luot an han muc goi thue bao chung nen de thap:
# 20 khach bam cung luc thi xep hang, khong phai 20 tien trinh.
ANALYSIS_WORKERS=2

# ---------- Nguon du lieu thi truong ----------
# VPS  : lich su tu 2000-07-28 (phien dau tien cua thi truong VN)
# VNDIRECT: lich su chi tu 2013-01-02
# KHONG doi qua lai ma khong nap lai toan bo: hai nguon dung he so dieu chinh co tuc khac nhau,
# tron lai se tao mot cu nhay gia gia o moc giao nhau. Xem VpsProvider trong providers.py.
MARKET_DATA_PROVIDER=VPS

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@tenmien.vn
SMTP_FROM_NAME="Tu van chung khoan"
SMTP_TLS=true

# ---------- SMS / Zalo ZNS ----------
SMS_PROVIDER=none                    # none | esms | zns
SMS_API_KEY=
SMS_SECRET=
SMS_BRANDNAME=
QUIET_HOURS_START=22                 # BR-816
QUIET_HOURS_END=7

# ---------- Telegram (Phần 15) ----------
TELEGRAM_BOT_TOKEN=                  # BR-881: chỉ để ở đây, không đưa vào mã nguồn
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=             # BR-882
TELEGRAM_CONNECT_TOKEN_TTL_MINUTES=15
TELEGRAM_MAX_MSG_PER_DAY=10          # BR-872
TELEGRAM_SEND_RATE_PER_SECOND=25     # BR-873 (giới hạn cứng ~30/s)
TELEGRAM_ALLOW_GROUP_CHAT=false      # BR-863
TELEGRAM_SEND_WINDOW_START=08:45     # BR-877
TELEGRAM_SEND_WINDOW_END=15:15
TELEGRAM_DIGEST_TIME=16:00

# ---------- Lưu trữ file tài liệu (BR-511) ----------
STORAGE_DIR=./storage/documents      # PHẢI nằm ngoài thư mục public
MAX_UPLOAD_MB=50                     # BR-510
ALLOWED_UPLOAD_EXT=pdf,docx,xlsx,pptx,png,jpg,jpeg
SIGNED_URL_TTL_SECONDS=300           # BR-511
PDF_WATERMARK=true                   # BR-512

# ---------- Cảnh báo vận hành (BR-700) ----------
ADMIN_ALERT_EMAILS=admin@tenmien.vn
ADMIN_ALERT_TELEGRAM_CHAT_ID=

# ---------- Seed ----------
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=admin@tenmien.vn
SEED_SUPER_ADMIN_PASSWORD=DoiMatKhauNgay@2026
